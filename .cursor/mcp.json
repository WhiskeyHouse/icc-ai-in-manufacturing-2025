{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp"],
      "env": {
        "NODE_ENV": "development",
        "PLAYWRIGHT_BROWSERS_PATH": "0"
      }
    },
    "ignition-fastmcp": {
      "type": "http",
      "url": "http://127.0.0.1:8007/mcp"
    },
    "ignition-linter": {
      "command": "python3",
      "args": ["-m", "ignition_lint.server", "--http"],
      "cwd": "../ignition-lint"
    }
  }
}
