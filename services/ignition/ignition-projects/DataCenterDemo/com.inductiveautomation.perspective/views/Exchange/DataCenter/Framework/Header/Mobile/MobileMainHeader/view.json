{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 56,
      "width": 260
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "CurrentPage"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "currPath": "{page.props.path}",
                  "inDesigner": "{session.props.device.userAgent}\u003d\u0027\u003cdesigner\u003e\u0027"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tcurrPath \u003d value[\u0027currPath\u0027]\n\tinDesigner \u003d value[\u0027inDesigner\u0027]\n\t\n\tif value[\u0027inDesigner\u0027]:\n\t\treturn \u0027Designer\u0027\n\telse:\n\t\tif value[\u0027currPath\u0027] \u003d\u003d \u0027/\u0027:\n\t\t\treturn \u0027Overview\u0027\n\t\telse:\n\t\t\tlabelMap \u003d {\u0027/alarms\u0027: \u0027Alarms \u0027, \u0027/architecture\u0027: \u0027Architecture\u0027, \n\t\t\t\t\u0027/heat-map\u0027: \u0027BMS Heat Map\u0027, \u0027/single-line\u0027: \u0027EPMS Single Line\u0027, \n\t\t\t\t\u0027/trends\u0027: \u0027Trends\u0027, \u0027/scenarios\u0027: \u0027Scenarios\u0027,\n\t\t\t\t\u0027/floor-plan\u0027: \u0027Floor Plan\u0027}\n\t\t\t\n\t\t\treturn labelMap.get(value[\u0027currPath\u0027], \u0027\u0027)",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "style": {
            "color": "--neutral-90",
            "fontFamily": "Roboto",
            "fontSize": "24px",
            "fontWeight": 500
          },
          "textStyle": {
            "overflow": "hidden",
            "textOverflow": "ellipsis",
            "whiteSpace": "nowrap"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\timport os\n\tdemoUrl \u003d os.getenv(\"URL_FRONTEND\")\n\tsystem.perspective.navigate(url\u003ddemoUrl)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "GoToDemo",
              "tooltip": {
                "enabled": true,
                "location": "bottom",
                "text": "Go to Online Demo"
              }
            },
            "position": {
              "basis": "30px",
              "shrink": 0
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "config": {
                    "path": "session.custom.featureFlags.homeButton.value"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "elements": [
                {
                  "d": "M160-120v-480l320-240 320 240v480H560v-280H400v280H160Z",
                  "name": "path",
                  "type": "path"
                }
              ],
              "style": {
                "classes": "exchange/datacenter/icon-mobile"
              },
              "viewBox": "0 -960 960 960"
            },
            "type": "ia.shapes.svg"
          },
          {
            "children": [
              {
                "children": [
                  {
                    "meta": {
                      "name": "ActiveAlarmCount"
                    },
                    "position": {
                      "basis": "20px",
                      "shrink": 0
                    },
                    "propConfig": {
                      "custom.activeAlarmCount": {
                        "binding": {
                          "config": {
                            "fallbackDelay": 2.5,
                            "mode": "direct",
                            "tagPath": "[DataCenterDemo]Exchange/DataCenterDemo/AlarmInfo/ActiveAlarmCount"
                          },
                          "type": "tag"
                        }
                      },
                      "position.display": {
                        "binding": {
                          "config": {
                            "expression": "{this.custom.activeAlarmCount} \u003e 0"
                          },
                          "type": "expr"
                        }
                      },
                      "props.style.classes": {
                        "binding": {
                          "config": {
                            "fallbackDelay": 2.5,
                            "mode": "direct",
                            "tagPath": "[DataCenterDemo]Exchange/DataCenterDemo/AlarmInfo/ActiveAlarmHighestPriority"
                          },
                          "transforms": [
                            {
                              "code": "\tpriorityStyleMap \u003d {\n\t\t\t\t\t\t\t1: \u0027exchange/datacenter/framework/alarmPriority/low\u0027,\n\t\t\t\t\t\t\t3: \u0027exchange/datacenter/framework/alarmPriority/high\u0027\n\t\t\t\t\t\t}\n\t\n\treturn \u0027exchange/datacenter/framework/alarm-count {backgroundStyle}\u0027.format(backgroundStyle \u003d priorityStyleMap.get(value, \u0027exchange/datacenter/framework/alarmPriority/default\u0027))",
                              "type": "script"
                            }
                          ],
                          "type": "tag"
                        }
                      },
                      "props.text": {
                        "binding": {
                          "config": {
                            "path": "this.custom.activeAlarmCount"
                          },
                          "transforms": [
                            {
                              "code": "\treturn value if value \u003c 100 else \u002799+\u0027",
                              "type": "script"
                            }
                          ],
                          "type": "property"
                        }
                      }
                    },
                    "props": {
                      "style": {
                        "marginTop": "-4px"
                      }
                    },
                    "type": "ia.display.label"
                  }
                ],
                "meta": {
                  "name": "ActiveAlarmCount"
                },
                "position": {
                  "basis": "0px",
                  "shrink": 0
                },
                "propConfig": {
                  "props.style.marginRight": {
                    "binding": {
                      "config": {
                        "expression": "if({./ActiveAlarmCount.custom.activeAlarmCount} \u003c 10, \u0027-3px\u0027, \r\nif({./ActiveAlarmCount.custom.activeAlarmCount} \u003c 100, \u0027-7.5px\u0027, \u0027-12px\u0027))"
                      },
                      "type": "expr"
                    }
                  },
                  "props.style.width": {
                    "binding": {
                      "config": {
                        "expression": "if({./ActiveAlarmCount.custom.activeAlarmCount} \u003c 10, \u002720px\u0027, \r\nif({./ActiveAlarmCount.custom.activeAlarmCount} \u003c 100, \u002725px\u0027, \u002730px\u0027))"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "direction": "column",
                  "style": {
                    "overflow": "visible",
                    "zIndex": 2
                  }
                },
                "type": "ia.container.flex"
              },
              {
                "children": [
                  {
                    "meta": {
                      "name": "Icon"
                    },
                    "position": {
                      "basis": "30px"
                    },
                    "props": {
                      "elements": [
                        {
