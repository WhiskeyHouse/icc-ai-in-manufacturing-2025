                          "name": "path",
                          "type": "path"
                        }
                      ],
                      "style": {
                        "width": "30px",
                        "zIndex": 1
                      },
                      "viewBox": "0 0 24 24"
                    },
                    "type": "ia.shapes.svg"
                  }
                ],
                "meta": {
                  "name": "Alarms"
                },
                "position": {
                  "basis": "30px",
                  "grow": 1
                },
                "props": {
                  "style": {
                    "overflow": "visible",
                    "zIndex": 1
                  }
                },
                "type": "ia.container.flex"
              }
            ],
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(\u0027/alarms\u0027)\n\tsystem.perspective.openDock(\u0027Footer\u0027)"
                  },
                  "scope": "G",
                  "type": "script"
                }
