          "config": {
            "script": "\tviewPath \u003d \"Exchange/DataCenter/Faceplates/PqmFp\"\n\ttagPath \u003d self.view.params.tagPath\n\tdeviceName \u003d self.view.custom.deviceName\n\tviewParams \u003d {\"tagPath\": tagPath, \"showClose\": True}\n\tpopupTitle \u003d self.view.custom.popupTitle\n\n\tpayload \u003d {\n\t\t  \u0027command\u0027 : \u0027openPopup\u0027\n\t\t, \u0027self\u0027: self\n\t\t, \u0027event\u0027: event\n\t\t, \u0027parameters\u0027: {\n\t\t\t\u0027id\u0027 : tagPath\n\t\t\t, \u0027view\u0027: viewPath\n\t\t\t, \u0027params\u0027: viewParams\n\t\t\t, \u0027title\u0027 : popupTitle\n\t\t\t, \u0027resizable\u0027 : False\n\t\t\t, \u0027modal\u0027: True\n\t\t\t, \u0027showCloseIcon\u0027: False\n\t\t}\n\t}\n\tsystem.perspective.sendMessage(\u0027pan-zoom-iframe-clicked\u0027, payload, scope \u003d \u0027session\u0027)"
          },
          "scope": "G",
          "type": "script"
        }
      }
