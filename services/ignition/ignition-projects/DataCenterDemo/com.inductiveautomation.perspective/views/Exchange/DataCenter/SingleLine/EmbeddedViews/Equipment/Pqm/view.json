  "propConfig": {
    "custom.activePowerTotal": {
      "persistent": true
    },
    "custom.activePowerTotal.units": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Power/ActivePowerTotal.EngUnit"
        },
        "type": "tag"
      }
    },
    "custom.activePowerTotal.value": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Power/ActivePowerTotal"
        },
        "type": "tag"
      }
    },
    "custom.alarmPriority": {
      "binding": {
        "config": {
          "struct": {
            "refresh": "{[default]Exchange/DataCenter/Watchdog/rate10sec}",
            "tagPath": "{view.params.tagPath}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\talarmMap \u003d {\n\t\t\t\"Low\": 1,\n\t\t\t\"High\": 3\n\t\t}\n\t\n\ttagPath \u003d value[\u0027tagPath\u0027]\n\t\n\treturn max(set([alarmMap.get(str(alarm.get(\"priority\"))) for alarm in system.alarm.queryStatus(state\u003d[\"ActiveUnacked\", \"ActiveAcked\"], path\u003d[\"*%s*\" % tagPath.rsplit(\"]\",1)[1]])] + [0]))",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.currentAvg": {
      "persistent": true
    },
    "custom.currentAvg.units": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Current/CurrentAbcMean.EngUnit"
        },
        "type": "tag"
      }
    },
    "custom.currentAvg.value": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Current/CurrentAbcMean"
        },
        "type": "tag"
      }
    },
    "custom.deviceName": {
      "binding": {
        "config": {
          "path": "view.params.tagPath"
        },
        "transforms": [
          {
            "code": "\treturn value.rsplit(\"/\",1)[1]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.popupTitle": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Info/PopupTitle"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.voltage": {
      "persistent": true
    },
    "custom.voltage.units": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
