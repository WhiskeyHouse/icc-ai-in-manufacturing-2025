        "enabled": null,
        "script": "\tif len(currentValue.value[\u0027values\u0027].value) \u003c 1:\n\t\treturn\n\t\n\tfrom threading import Timer\n\t\n\tlowTemp \u003d float(currentValue.value[\u0027config\u0027].value[\u0027lowSetpoint\u0027].value)\n\thighTemp \u003d float(currentValue.value[\u0027config\u0027].value[\u0027highSetpoint\u0027].value)\n\tlowColor \u003d (\n\t\tfloat(currentValue.value[\u0027config\u0027].value[\u0027lowColor\u0027].value[\u0027r\u0027].value), \n\t\tfloat(currentValue.value[\u0027config\u0027].value[\u0027lowColor\u0027].value[\u0027g\u0027].value), \n\t\tfloat(currentValue.value[\u0027config\u0027].value[\u0027lowColor\u0027].value[\u0027b\u0027].value),\n\t\tfloat(currentValue.value[\u0027config\u0027].value[\u0027lowColor\u0027].value[\u0027a\u0027].value)\n\t\t)\n\tmidColor \u003d (\n\t\tfloat(currentValue.value[\u0027config\u0027].value[\u0027midColor\u0027].value[\u0027r\u0027].value), \n\t\tfloat(currentValue.value[\u0027config\u0027].value[\u0027midColor\u0027].value[\u0027g\u0027].value), \n\t\tfloat(currentValue.value[\u0027config\u0027].value[\u0027midColor\u0027].value[\u0027b\u0027].value),\n\t\tfloat(currentValue.value[\u0027config\u0027].value[\u0027midColor\u0027].value[\u0027a\u0027].value)\n\t\t)\n\thighColor \u003d (\n\t\tfloat(currentValue.value[\u0027config\u0027].value[\u0027highColor\u0027].value[\u0027r\u0027].value), \n\t\tfloat(currentValue.value[\u0027config\u0027].value[\u0027highColor\u0027].value[\u0027g\u0027].value), \n\t\tfloat(currentValue.value[\u0027config\u0027].value[\u0027highColor\u0027].value[\u0027b\u0027].value),\n\t\tfloat(currentValue.value[\u0027config\u0027].value[\u0027highColor\u0027].value[\u0027a\u0027].value)\n\t\t)\n\t\n\tisLows \u003d []\n\tdef getColor(temperature):\n\t\n\t\t# Calculate ratio\n\t\tratio \u003d max(min((temperature - lowTemp) / (highTemp - lowTemp),1.0),0.0)\n\t\t\n\t\t# Interpolate color\n\t\tif ratio \u003c 0.5:\n\t\t\tscale \u003d ratio * 2\n\t\t\tcolor \u003d [low + scale * (high - low) for low, high in zip(lowColor, midColor)]\n\t\t\tisLows.append(True)\n\t\telif ratio \u003d\u003d 0.5:\n\t\t\tcolor \u003d midColor\n\t\t\tisLows.append(None)\n\t\telse:\n\t\t\tscale \u003d (ratio - 0.5) * 2\n\t\t\tcolor \u003d [low + scale * (high - low) for low, high in zip(midColor, highColor)]\n\t\t\tisLows.append(False)\n\t\t\t\n\t\treturn color\n\t\t\n\tdef getMidColor(color1, color2):\n\t\tcolor \u003d [(c1+c2)/2.0 for c1, c2 in zip(color1, color2)]\n\t\treturn color\n\t   \n\tdef makeGradient(temperatures):\n\t\tcolors \u003d [getColor(temp) for temp in temperatures]\n\n\t\t# insert middle points\n\t\tgradients \u003d []\n\t\tfor i in range(len(colors)-1):\n\t\t\tgradients.append(colors[i])\n\t\t\tif isLows[i] !\u003d isLows[i+1] and (isLows[i] and isLows[i+1]) !\u003d None:\n\t\t\t\tgradients.append(midColor)\n\t\t\telse:\n\t\t\t\tgradients.append(getMidColor(colors[i],colors[i+1]))\n\t\tgradients.append(colors[-1])\t\t\t\n\t\t\n\t\tgradient \u003d \u0027linear-gradient(to bottom, \u0027 + \u0027, \u0027.join([\u0027rgba\u0027+str(tuple(color)) for color in gradients]) + \u0027)\u0027\n\t\treturn gradient\n\t\n\t# make labelInstances\n\tvalues \u003d [v.value for v in currentValue.value[\u0027values\u0027].value]\n\talarms \u003d [a.value for a in currentValue.value[\u0027alarms\u0027].value]\n\tlabelInstances \u003d []\n\tlabelInstances.append({\"instancePosition\": {\u0027basis\u0027:0}})\n\tdisplayValues \u003d []\n\t\n\tfor i, val in enumerate(values):\n\t\ttry:\n\t\t\tappendValue \u003d float(alarms[i])\n\t\t\tclasses \u003d \u0027exchange/datacenter/heatmap/temperature-alarm exchange/datacenter/heatmap/temperature-label\u0027\n\t\texcept:\n\t\t\tappendValue \u003d val if val else 0\n\t\t\tclasses \u003d \u0027exchange/datacenter/heatmap/temperature-label\u0027\n\n\t\tdisplayValues.append(appendValue)\n\t\tlabelInstances.append({\n\t\t\t\"instanceStyle\": {\"classes\": classes},\n\t\t\t\"text\": \"%0.1f %s\" % (appendValue, currentValue.value[\u0027units\u0027].value)\n\t\t})\n\n\tlabelInstances.append({\"instancePosition\": {\u0027basis\u0027:0}})\n\t\n\t# add value padding to gradient depending on aisle type\n\tif self.params.inputs.isColdAisle:\n\t\t# cold aisles have ambient temperature on start and end\n\t\taugmentedValues \u003d [currentValue.value[\u0027ambientValue\u0027].value] + displayValues + [currentValue.value[\u0027ambientValue\u0027].value]\n\telse:\n\t\t# hot aisles are enclosed so values should duplicate first and last values\n\t\taugmentedValues \u003d [displayValues[0]] + displayValues + [displayValues[-1]]\n\tnewGradient \u003d makeGradient(augmentedValues)\n\t\n\t# animate transition, change labels after animation\n\tfade1 \u003d \u0027exchange/datacenter/heatmap/gradient-fade-1\u0027\n\tfade2 \u003d \u0027exchange/datacenter/heatmap/gradient-fade-2\u0027\n\t\n\t# write to custom properties\n\tif self.custom.gradient.foregroundStyle !\u003d fade1:\n\t\tself.custom.gradient.foregroundStyle \u003d fade1\n\telse:\n\t\tself.custom.gradient.foregroundStyle \u003d fade2\n\t\n\t\n\tself.custom.gradient.background \u003d newGradient\n\tself.custom.labelInstances \u003d labelInstances\n\t\n\tdef changeForeground():\n\t\tself.custom.gradient.foreground \u003d newGradient\n\tTimer(1, changeForeground).start()"
      },
