def format_validation_result_html(validation_result, content):
    """Format validation results as HTML for browser viewing"""
    html = "<h1>Validation Results</h1>"
    
    # Status overview
    status = "PASSED" if validation_result.get("valid", False) else "FAILED"
    status_color = "green" if validation_result.get("valid", False) else "red"
    html += "<h2 style='color: " + status_color + "'>Status: " + status + "</h2>"
    
    # Score
    score = validation_result.get("score", 0)
    html += "<p><strong>Score:</strong> " + str(score) + "/100</p>"
    
    # Violations
    violations = validation_result.get("violations", [])
    if violations:
        html += "<h3>Violations Found:</h3><ul>"
        for violation in violations:
            html += "<li><strong>" + violation.get("rule_id", "Unknown") + ":</strong> " + violation.get("message", "No message") + "</li>"
        html += "</ul>"
    else:
        html += "<p style='color: green;'>No violations found!</p>"
    
    # Error details
    if "error" in validation_result:
        html += "<h3 style='color: red;'>Error:</h3><p>" + str(validation_result["error"]) + "</p>"
    
    # Original content
    html += "<h3>Original Content:</h3><pre style='background: #f5f5f5; padding: 10px; border-radius: 5px;'>" + str(content) + "</pre>"
    
    # Full response
    html += "<h3>Full Response:</h3><pre style='background: #f0f0f0; padding: 10px; border-radius: 5px;'>" + json.dumps(validation_result, indent=2) + "</pre>"
    
    return html