def validate_script_with_rules_engine(script_content, context=None):
    """Validate script using the rules engine service"""
    try:
        # Prepare request payload
        payload = {
            "script": script_content,
            "context": context or {}
        }
        
        # Call rules engine
        response = system.net.httpPost(
            "http://host.docker.internal:8087/validate/script",
            {"Content-Type": "application/json"},
            json.dumps(payload)
        )
        
        if response:
            return json.loads(response)
        else:
            return {
                "valid": False,
                "error": "No response from rules engine",
                "violations": [],
                "score": 0
            }
            
    except Exception as e:
        return {
            "valid": False,
            "error": "Rules engine communication failed: " + str(e),
            "violations": [],
            "score": 0
        }


