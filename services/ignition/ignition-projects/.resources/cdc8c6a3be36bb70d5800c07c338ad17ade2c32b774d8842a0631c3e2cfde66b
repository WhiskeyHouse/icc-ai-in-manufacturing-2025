"""
WebDev POST Handler for Validation API
Handles POST requests for validation endpoints
"""

import json
import system

def doPost(request, session):
    """
    Handle POST requests for validation API
    
    Supported endpoints:
    - /system/webdev/Global/validation/scripts - Validate Jython script
    - /system/webdev/Global/validation/components - Validate Perspective component
    """
    
    try:
        # Get the path after /system/webdev/Global/validation
        path_info = request.get('pathInfo', '')
        
        if path_info == '/scripts':
            # Validate Jython script
            return handle_script_validation(request)
            
        elif path_info == '/components':
            # Validate Perspective component
            return handle_component_validation(request)
            
        else:
            # Unknown endpoint
            error_response = {
                'error': 'Endpoint not found',
                'path': path_info,
                'available_endpoints': ['/scripts', '/components']
            }
            return {'html': '<pre>' + json.dumps(error_response, indent=2) + '</pre>'}
    
    except Exception as e:
        error_response = {
            'error': 'Internal server error',
            'message': str(e)
        }
        return {'html': '<pre>' + json.dumps(error_response, indent=2) + '</pre>'}


def handle_script_validation(request):
    """Handle script validation POST request"""
    try:
        # Get request body
        post_data = request.get('postData', '')
        if not post_data:
            error_response = {'error': 'Request body is required'}
            return {'html': '<pre>' + json.dumps(error_response, indent=2) + '</pre>'}
        
        # Parse JSON data
        try:
            data = json.loads(post_data)
        except:
            error_response = {'error': 'Invalid JSON in request body'}
            return {'html': '<pre>' + json.dumps(error_response, indent=2) + '</pre>'}
        
        # Validate required fields
        if 'script' not in data:
            error_response = {'error': 'script field is required'}
            return {'html': '<pre>' + json.dumps(error_response, indent=2) + '</pre>'}
        
        script_content = data['script']
        context = data.get('context', {})
        
        # Validate script using rules engine
        validation_result = validate_script_with_rules_engine(script_content, context)
        
        # Format response as HTML for browser viewing
        response_html = format_validation_result_html(validation_result, script_content)
        return {'html': response_html}
        
    except Exception as e:
        error_response = {
            'error': 'Script validation failed',
            'message': str(e)
        }
        return {'html': '<pre>' + json.dumps(error_response, indent=2) + '</pre>'}


