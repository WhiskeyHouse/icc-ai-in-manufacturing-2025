{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 400,
      "width": 280
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "InteractionContainer"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "20px"
          }
        },
        "children": [
          {
            "meta": {
              "name": "AIChatBubble"
            },
            "props": {
              "style": {
                "backgroundColor": "#3498db",
                "borderRadius": "15px",
                "padding": "15px",
                "color": "#ffffff",
                "fontSize": "14px",
                "lineHeight": "1.4",
                "position": "relative",
                "boxShadow": "0 2px 8px rgba(0,0,0,0.1)"
              }
            },
            "children": [
              {
                "meta": {
                  "name": "AIMessage"
                },
                "props": {
                  "style": {
                    "color": "#ffffff",
                    "fontSize": "14px",
                    "lineHeight": "1.4"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "tag",
                      "config": {
                        "tagPath": "[Global]WhiskeyLab/AI/CurrentMessage",
                        "fallbackDelay": 2.5
                      }
                    }
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "type": "ia.container.coord"
          },
          {
            "meta": {
              "name": "ActionButtons"
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "15px"
              }
            },
            "children": [
              {
                "meta": {
                  "name": "AcceptButton"
                },
                "props": {
                  "text": "✅ Accept AI Action",
                  "style": {
                    "backgroundColor": "#27ae60",
                    "color": "#ffffff",
                    "border": "none",
                    "borderRadius": "8px",
                    "padding": "15px 20px",
                    "fontSize": "16px",
                    "fontWeight": "bold",
                    "cursor": "pointer",
                    "width": "100%",
                    "transition": "all 0.3s ease"
                  }
                },
                "events": {
                  "onActionPerformed": [
                    {
                      "type": "script",
                      "script": "# Handle Accept AI Action\nimport system.date\n\n# Update AI response\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/LastAction'], ['ACCEPTED'])\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/LastActionTime'], [system.date.now()])\n\n# Update current message\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/CurrentMessage'], ['Great! Proceeding with AI recommendation. Monitoring system...'])\n\n# Add log entry\ntimestamp = system.date.format(system.date.now(), 'HH:mm:ss')\nlog_entry = '✅ [' + timestamp + '] Operator accepted AI recommendation - Continuing automated control'\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/CurrentLogEntry'], [log_entry])\n\n# Update confidence\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/Confidence'], [95])"
                    }
                  ]
                },
                "type": "ia.input.button"
              },
              {
                "meta": {
                  "name": "OverrideButton"
                },
                "props": {
                  "text": "❌ Override AI",
                  "style": {
                    "backgroundColor": "#e74c3c",
                    "color": "#ffffff",
                    "border": "none",
                    "borderRadius": "8px",
                    "padding": "15px 20px",
                    "fontSize": "16px",
                    "fontWeight": "bold",
                    "cursor": "pointer",
                    "width": "100%",
                    "transition": "all 0.3s ease"
                  }
                },
                "events": {
                  "onActionPerformed": [
                    {
                      "type": "script",
                      "script": "# Handle Override AI Action\nimport system.date\n\n# Update AI response\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/LastAction'], ['OVERRIDDEN'])\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/LastActionTime'], [system.date.now()])\n\n# Update current message\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/CurrentMessage'], ['Understood. Switching to manual control mode. Please specify your preferred action.'])\n\n# Add log entry\ntimestamp = system.date.format(system.date.now(), 'HH:mm:ss')\nlog_entry = '⚠️ [' + timestamp + '] Operator override activated - AI recommendations suspended'\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/CurrentLogEntry'], [log_entry])\n\n# Update confidence\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/Confidence'], [60])"
                    }
                  ]
                },
                "type": "ia.input.button"
              }
            ],
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "StatusSection"
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "10px",
                "backgroundColor": "#ecf0f1",
                "borderRadius": "8px",
                "padding": "15px"
              }
            },
            "children": [
              {
                "meta": {
                  "name": "LastActionLabel"
                },
                "props": {
                  "text": "Last Action:",
                  "style": {
                    "fontSize": "12px",
                    "fontWeight": "bold",
                    "color": "#7f8c8d"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "LastActionValue"
                },
                "props": {
                  "style": {
                    "fontSize": "14px",
                    "fontWeight": "bold"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "tag",
                      "config": {
                        "tagPath": "[Global]WhiskeyLab/AI/LastAction",
                        "fallbackDelay": 2.5
                      }
                    }
                  },
                  "props.style.color": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({[Global]WhiskeyLab/AI/LastAction} = 'ACCEPTED', '#27ae60', if({[Global]WhiskeyLab/AI/LastAction} = 'OVERRIDDEN', '#e74c3c', '#95a5a6'))"
                      }
                    }
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "ActionTimeLabel"
                },
                "props": {
                  "text": "Time:",
                  "style": {
                    "fontSize": "12px",
                    "fontWeight": "bold",
                    "color": "#7f8c8d"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "ActionTimeValue"
                },
                "props": {
                  "format": "HH:mm:ss",
                  "style": {
                    "fontSize": "12px",
                    "color": "#2c3e50"
                  }
                },
                "propConfig": {
                  "props.datetime": {
                    "binding": {
                      "type": "tag",
                      "config": {
                        "tagPath": "[Global]WhiskeyLab/AI/LastActionTime",
                        "fallbackDelay": 2.5
                      }
                    }
                  }
                },
                "type": "ia.display.datetime"
              }
            ],
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "QuickActions"
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "8px"
              }
            },
            "children": [
              {
                "meta": {
                  "name": "QuickActionsLabel"
                },
                "props": {
                  "text": "Quick Actions:",
                  "style": {
                    "fontSize": "12px",
                    "fontWeight": "bold",
                    "color": "#7f8c8d"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "EmergencyStopButton"
                },
                "props": {
                  "text": "🛑 Emergency Stop",
                  "style": {
                    "backgroundColor": "#c0392b",
                    "color": "#ffffff",
                    "border": "none",
                    "borderRadius": "6px",
                    "padding": "10px 15px",
                    "fontSize": "12px",
                    "fontWeight": "bold",
                    "cursor": "pointer",
                    "width": "100%"
                  }
                },
                "events": {
                  "onActionPerformed": [
                    {
                      "type": "script",
                      "script": "# Emergency Stop\nimport system.date\n\n# Stop all operations\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/Tank1/Status'], ['STOPPED'])\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/CurrentMessage'], ['EMERGENCY STOP ACTIVATED! All operations halted.'])\n\n# Add log entry\ntimestamp = system.date.format(system.date.now(), 'HH:mm:ss')\nlog_entry = '🛑 [' + timestamp + '] EMERGENCY STOP - All operations halted by operator'\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/CurrentLogEntry'], [log_entry])\n\n# Update confidence to 0\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/Confidence'], [0])"
                    }
                  ]
                },
                "type": "ia.input.button"
              },
              {
                "meta": {
                  "name": "ResetButton"
                },
                "props": {
                  "text": "🔄 Reset System",
                  "style": {
                    "backgroundColor": "#95a5a6",
                    "color": "#ffffff",
                    "border": "none",
                    "borderRadius": "6px",
                    "padding": "8px 12px",
                    "fontSize": "11px",
                    "cursor": "pointer",
                    "width": "100%"
                  }
                },
                "events": {
                  "onActionPerformed": [
                    {
                      "type": "script",
                      "script": "# Reset System\nimport system.date\n\n# Reset to initial state\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/Tank1/Status'], ['OK'])\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/Tank1/Temperature'], [75.0])\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/Tank1/FillLevel'], [45.0])\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/CurrentMessage'], ['System reset complete. Ready for operation.'])\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/Confidence'], [85])\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/LastAction'], ['RESET'])\n\n# Add log entry\ntimestamp = system.date.format(system.date.now(), 'HH:mm:ss')\nlog_entry = '🔄 [' + timestamp + '] System reset - All parameters restored to defaults'\nsystem.tag.writeBlocking(['[Global]WhiskeyLab/AI/CurrentLogEntry'], [log_entry])"
                    }
                  ]
                },
                "type": "ia.input.button"
              }
            ],
            "type": "ia.container.flex"
          }
        ],
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": "10px"
      }
    },
    "type": "ia.container.flex"
  }
}