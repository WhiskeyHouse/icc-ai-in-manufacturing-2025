{
  "custom": {
    "active": false,
    "alarmPriority": 0,
    "current": 0,
    "deviceName": "GEN1A",
    "popupTitle": "Site 1 - Data Hall 1 - Section 1 - GEN 1A",
    "power": 0,
    "status": "Standby",
    "voltage": 0
  },
  "params": {
    "tagPath": "[DataCenterDemo]Exchange/DataCenterDemo/Site1/DataHall1/Section1/GEN/GEN1A"
  },
  "propConfig": {
    "custom.active": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Status/State"
        },
        "transforms": [
          {
            "expression": "{value}\u003d\u0027Running\u0027",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.alarmPriority": {
      "binding": {
        "config": {
          "struct": {
            "tagPath": "{view.params.tagPath}",
            "watchdog": "{[default]Exchange/DataCenter/Watchdog/rate10sec}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\ttagPath \u003d value.tagPath\n\talarmMap \u003d {\n\t\t\t\"Low\": 1,\n\t\t\t\"High\": 3\n\t\t}\n\treturn max(set([alarmMap.get(str(alarm.get(\"priority\"))) for alarm in system.alarm.queryStatus(state\u003d[\"ActiveUnacked\", \"ActiveAcked\"], path\u003d[\"*%s*\" % tagPath.rsplit(\"]\",1)[1]])] + [0]))",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.current": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Metering/AvgCurrent"
        },
        "transforms": [
          {
            "expression": "round({value},2)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.deviceName": {
      "binding": {
        "config": {
          "path": "view.params.tagPath"
        },
        "transforms": [
          {
            "code": "\treturn value.rsplit(\"/\",1)[1]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.popupTitle": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Info/PopupTitle"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.power": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Power/RealPowerTotal"
        },
        "transforms": [
          {
            "expression": "round({value},2)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.status": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Status/Status"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.voltage": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Metering/AvgVoltageLL"
        },
        "transforms": [
          {
            "expression": "round({value},1)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 128,
      "width": 237
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "DeviceName"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.deviceName"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/datacenter/faceplates/lvswg/diagram/label"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "DeviceStatus"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.custom.status}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/datacenter/faceplates/lvswg/diagram/label"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "justify": "space-evenly",
      "style": {
        "classes": "exchange/datacenter/singleline/equipment/device/off",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}