{
  "custom": {
    "active": false,
    "alarmPriority": 0,
    "current": 0,
    "deviceName": "GEN1A",
    "popupTitle": "Site 1 - Data Hall 1 - Section 1 - GEN 1A",
    "power": 0,
    "status": "Standby",
    "voltage": 0
  },
  "params": {
    "tagPath": "[DataCenterDemo]Exchange/DataCenterDemo/Site1/DataHall1/Section1/GEN/GEN1A"
  },
  "propConfig": {
    "custom.active": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Status/State"
        },
        "transforms": [
          {
            "expression": "{value}\u003d\u0027Running\u0027",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.alarmPriority": {
      "binding": {
        "config": {
          "struct": {
            "tagPath": "{view.params.tagPath}",
            "watchdog": "{[default]Exchange/DataCenter/Watchdog/rate10sec}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\ttagPath \u003d value.tagPath\n\talarmMap \u003d {\n\t\t\t\"Low\": 1,\n\t\t\t\"High\": 3\n\t\t}\n\treturn max(set([alarmMap.get(str(alarm.get(\"priority\"))) for alarm in system.alarm.queryStatus(state\u003d[\"ActiveUnacked\", \"ActiveAcked\"], path\u003d[\"*%s*\" % tagPath.rsplit(\"]\",1)[1]])] + [0]))",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.current": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Metering/AvgCurrent"
        },
        "transforms": [
          {
            "expression": "round({value},2)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.deviceName": {
      "binding": {
        "config": {
          "path": "view.params.tagPath"
        },
        "transforms": [
          {
            "code": "\treturn value.rsplit(\"/\",1)[1]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.popupTitle": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Info/PopupTitle"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.power": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Power/RealPowerTotal"
        },
        "transforms": [
          {
            "expression": "round({value},2)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.status": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Status/Status"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.voltage": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Metering/AvgVoltageLL"
        },
        "transforms": [
          {
            "expression": "round({value},1)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 128,
      "width": 237
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "DeviceName"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.deviceName"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/datacenter/singleline/equipment/common/base"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "DeviceStatus"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.custom.status}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/datacenter/singleline/equipment/common/base"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tviewPath \u003d \"Exchange/DataCenter/Faceplates/GenFp\"\n\ttagPath \u003d self.view.params.tagPath\n\tpopupTitle \u003d self.view.custom.popupTitle\n\tviewParams \u003d {\"tagPath\": tagPath}\n\n\tpayload \u003d {\n\t\t  \u0027command\u0027 : \u0027openPopup\u0027\n\t\t, \u0027self\u0027: self\n\t\t, \u0027event\u0027: event\n\t\t, \u0027parameters\u0027: {\n\t\t\t\u0027id\u0027 : tagPath\n\t\t\t, \u0027view\u0027: viewPath\n\t\t\t, \u0027params\u0027: viewParams\n\t\t\t, \u0027title\u0027 : popupTitle\n\t\t\t, \u0027resizable\u0027: False\n\t\t\t, \u0027modal\u0027: True\n\t\t\t, \u0027showCloseIcon\u0027: False\n\t\t}\n\t}\n\t\n\tsystem.perspective.sendMessage(\u0027pan-zoom-iframe-clicked\u0027, payload, scope \u003d \u0027session\u0027)"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "if({view.custom.active},\"exchange/datacenter/singleline/equipment/device/on exchange/datacenter/framework/clickable\", \"exchange/datacenter/singleline/equipment/device/off exchange/datacenter/framework/clickable\")"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "direction": "column",
      "justify": "space-evenly",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}