{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 500,
      "width": 600
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "LogContainer"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "10px"
          }
        },
        "children": [
          {
            "meta": {
              "name": "LogArea"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "backgroundColor": "#2c3e50",
                "borderRadius": "8px",
                "padding": "15px",
                "color": "#ecf0f1",
                "fontFamily": "monospace",
                "fontSize": "14px",
                "lineHeight": "1.4",
                "overflow": "auto",
                "maxHeight": "400px",
                "border": "2px solid #34495e"
              }
            },
            "children": [
              {
                "meta": {
                  "name": "LogEntry1"
                },
                "props": {
                  "text": "✅ [12:34:15] Started production at 75°F - Optimal temperature range detected",
                  "style": {
                    "color": "#27ae60",
                    "marginBottom": "8px",
                    "display": "block"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "LogEntry2"
                },
                "props": {
                  "text": "📊 [12:35:22] Monitoring fill level at 45% - Within normal parameters",
                  "style": {
                    "color": "#3498db",
                    "marginBottom": "8px",
                    "display": "block"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "LogEntry3"
                },
                "props": {
                  "text": "⚠️ [12:36:45] Temperature rising to 78°F - Evaluating cooling options...",
                  "style": {
                    "color": "#f39c12",
                    "marginBottom": "8px",
                    "display": "block"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "LogEntry4"
                },
                "props": {
                  "text": "🔧 [12:37:12] Activated cooling system - Preventing overheating scenario",
                  "style": {
                    "color": "#9b59b6",
                    "marginBottom": "8px",
                    "display": "block"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "LogEntry5"
                },
                "props": {
                  "text": "✅ [12:38:30] Temperature stabilized at 76°F - System operating normally",
                  "style": {
                    "color": "#27ae60",
                    "marginBottom": "8px",
                    "display": "block"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "LogEntry6"
                },
                "props": {
                  "text": "🤖 [12:39:15] AI Confidence: 94% - All parameters within acceptable ranges",
                  "style": {
                    "color": "#1abc9c",
                    "marginBottom": "8px",
                    "display": "block"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "CurrentLogEntry"
                },
                "props": {
                  "style": {
                    "marginBottom": "8px",
                    "display": "block"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "tag",
                      "config": {
                        "tagPath": "[Global]WhiskeyLab/AI/CurrentLogEntry",
                        "fallbackDelay": 2.5
                      }
                    }
                  },
                  "props.style.color": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if(find({[Global]WhiskeyLab/AI/CurrentLogEntry}, '✅') >= 0, '#27ae60', if(find({[Global]WhiskeyLab/AI/CurrentLogEntry}, '⚠️') >= 0, '#f39c12', if(find({[Global]WhiskeyLab/AI/CurrentLogEntry}, '⛔') >= 0, '#e74c3c', '#ecf0f1')))"
                      }
                    }
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "type": "ia.container.coord"
          },
          {
            "meta": {
              "name": "LogControls"
            },
            "props": {
              "style": {
                "gap": "10px",
                "justifyContent": "center"
              }
            },
            "children": [
              {
                "meta": {
                  "name": "ClearLogButton"
                },
                "props": {
                  "text": "Clear Log",
                  "style": {
                    "backgroundColor": "#95a5a6",
                    "color": "#ffffff",
                    "border": "none",
                    "borderRadius": "4px",
                    "padding": "8px 16px",
                    "fontSize": "12px",
                    "cursor": "pointer"
                  }
                },
                "type": "ia.input.button"
              },
              {
                "meta": {
                  "name": "AutoScrollToggle"
                },
                "props": {
                  "text": "Auto-scroll",
                  "selected": true,
                  "style": {
                    "fontSize": "12px"
                  }
                },
                "type": "ia.input.checkbox"
              }
            ],
            "type": "ia.container.flex"
          }
        ],
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": "10px"
      }
    },
    "type": "ia.container.flex"
  }
}