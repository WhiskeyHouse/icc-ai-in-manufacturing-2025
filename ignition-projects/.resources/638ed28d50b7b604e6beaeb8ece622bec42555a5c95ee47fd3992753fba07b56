{
  "custom": {
    "active": true,
    "activePower": "167.85",
    "alarmPriority": 0,
    "deviceName": "PDU1A",
    "popupTitle": "Site 1 - Data Hall 1 - Section 1 - PDU 1A",
    "status": "Warning"
  },
  "params": {
    "tagPath": "[DataCenterDemo]Exchange/DataCenterDemo/Site1/DataHall1/Section1/PDU/PDU1A"
  },
  "propConfig": {
    "custom.active": {
      "persistent": true
    },
    "custom.activePower": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Inlet/Inlet1/ActivePower"
        },
        "transforms": [
          {
            "formatType": "numeric",
            "formatValue": "0.##",
            "type": "format"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.alarmPriority": {
      "binding": {
        "config": {
          "struct": {
            "tagPath": "{view.params.tagPath}",
            "watchdog": "{[default]Exchange/DataCenter/Watchdog/rate10sec}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\ttagPath \u003d value.tagPath\n\talarmMap \u003d {\n\t\t\t\"Low\": 1,\n\t\t\t\"High\": 3\n\t\t}\n\n\treturn max(set([alarmMap.get(str(alarm.get(\"priority\"))) for alarm in system.alarm.queryStatus(state\u003d[\"ActiveUnacked\", \"ActiveAcked\"], path\u003d[\"*%s*\" % tagPath.rsplit(\"]\",1)[1]])] + [0]))",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.deviceName": {
      "binding": {
        "config": {
          "path": "view.params.tagPath"
        },
        "transforms": [
          {
            "code": "\treturn value.rsplit(\"/\",1)[1]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.popupTitle": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Info/PopupTitle"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.status": {
      "binding": {
        "config": {
          "struct": {
            "tagPath": "{view.params.tagPath}",
            "watchdog": "{[default]Exchange/DataCenter/rate30sec}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\ttagPath \u003d value.tagPath\n\t\n\tstatusMap \u003d {\n\t\t\"False\": \"Warning\",\n\t\t\"True\": \"Normal\"\n\t}\n\t\n\toutletControlCoilStatus \u003d all([a.value for a in system.tag.readBlocking([\"%s/IsControlCoilEnergized\" % tag.get(\"fullPath\") for tag in system.tag.browse(\"%s/Outlet\" % tagPath)])])\n\tocpTripped \u003d all([a.value for a in system.tag.readBlocking([\"%s/IsOcpTripped\" % tag.get(\"fullPath\") for tag in system.tag.browse(\"%s/Ocp\" % tagPath)])])\n\tinletSPStatus \u003d all([a.value for a in system.tag.readBlocking([\"%s/IsSurgeProtectorHealthy\" % tag.get(\"fullPath\") for tag in system.tag.browse(\"%s/Inlet\" % tagPath)])])\n\t\n\tstatus \u003d outletControlCoilStatus and not ocpTripped and not inletSPStatus\n\treturn statusMap.get(str(status))",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 150,
      "width": 106
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "AlarmIndicator"
        },
        "position": {
          "basis": "30%",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.alarmPriority} \u003e 0"
              },
              "type": "expr"
            }
          },
          "props.params.priority": {
            "binding": {
              "config": {
                "path": "view.custom.alarmPriority"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "path": "Exchange/DataCenter/Framework/Alarms/AlarmIndicator"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "DeviceName"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.deviceName"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/datacenter/singleline/equipment/common/base"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "DeviceStatus"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.custom.status}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/datacenter/singleline/equipment/common/base exchange/datacenter/singleline/equipment/common/value"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "ActivePower"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.custom.activePower} + \" kW\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/datacenter/singleline/equipment/common/base exchange/datacenter/singleline/equipment/common/value"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tviewPath \u003d \"Exchange/DataCenter/Faceplates/PduFp\"\n\ttagPath \u003d self.view.params.tagPath\n\tviewParams \u003d {\"tagPath\": tagPath}\n\tpopupTitle \u003d self.view.custom.popupTitle\n\n\tpayload \u003d {\n\t\t  \u0027command\u0027 : \u0027openPopup\u0027\n\t\t, \u0027self\u0027: self\n\t\t, \u0027event\u0027: event\n\t\t, \u0027parameters\u0027: {\n\t\t\t\u0027id\u0027 : tagPath\n\t\t\t, \u0027view\u0027: viewPath\n\t\t\t, \u0027params\u0027: viewParams\n\t\t\t, \u0027title\u0027 : popupTitle\n\t\t\t, \u0027resizable\u0027 : True\n\t\t\t, \u0027modal\u0027: True\n\t\t\t, \u0027showCloseIcon\u0027: False\n\t\t}\n\t}\n\tsystem.perspective.sendMessage(\u0027pan-zoom-iframe-clicked\u0027, payload, scope \u003d \u0027session\u0027)"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "justify": "space-evenly",
      "style": {
        "classes": "exchange/datacenter/singleline/equipment/device/on exchange/datacenter/framework/clickable",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}