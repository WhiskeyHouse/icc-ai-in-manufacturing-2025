                    "script": "\tif self.session.custom.alarmsPage.currentTab \u003d\u003d \u0027alarmStatus\u0027:\t\t\n\t\t# Get the default config for the Alarm Status table.\n\t\tdefaultStatusConfig \u003d self.view.getChild(\"root\").custom.defaultAlarmStatusConfig\n\t\t\n\t\t# Set the columns.\n\t\tself.parent.parent.getChild(\"AlarmStatusTable\").props.columns \u003d defaultStatusConfig[\u0027columns\u0027]\n\t\t\n\t\t# Set the filters for the active tab.\n\t\tself.parent.parent.getChild(\"AlarmStatusTable\").props.filters.active.states \u003d defaultStatusConfig[\u0027filters\u0027][\u0027active\u0027][\u0027states\u0027]\n\t\tself.parent.parent.getChild(\"AlarmStatusTable\").props.filters.active.priorities \u003d defaultStatusConfig[\u0027filters\u0027][\u0027active\u0027][\u0027priorities\u0027]\n\t\tself.parent.parent.getChild(\"AlarmStatusTable\").props.filters.active.text \u003d defaultStatusConfig[\u0027filters\u0027][\u0027active\u0027][\u0027text\u0027]\n\t\t\n\t\t# Set the search text for the shelved tab.\n\t\tself.parent.parent.getChild(\"AlarmStatusTable\").props.filters.shelved.text \u003d defaultStatusConfig[\u0027filters\u0027][\u0027shelved\u0027][\u0027text\u0027]\n\telse:\n\t\t# Get the default config for the Alarm Journal table.\n\t\tdefaultJournalConfig \u003d self.view.getChild(\"root\").custom.defaultAlarmJournalConfig\n\t\t\n\t\t# Set the columns.\n\t\tself.parent.parent.getChild(\"AlarmJournalTable\").props.columns \u003d defaultJournalConfig[\u0027columns\u0027]\n\t\t\n\t\t# Set the date range.\n\t\tself.parent.parent.getChild(\"AlarmJournalTable\").props.dateRange \u003d defaultJournalConfig[\u0027dateRange\u0027]\n\t\t\n\t\t# Set the filters.\n\t\tself.parent.parent.getChild(\"AlarmJournalTable\").props.filter.events \u003d defaultJournalConfig[\u0027filter\u0027][\u0027events\u0027]\n\t\tself.parent.parent.getChild(\"AlarmJournalTable\").props.filter.priorities \u003d defaultJournalConfig[\u0027filter\u0027][\u0027priorities\u0027]\n\t\tself.parent.parent.getChild(\"AlarmJournalTable\").props.filter.text \u003d defaultJournalConfig[\u0027filter\u0027][\u0027text\u0027]"
                  },
