                    {
                      "code": "\t# Get the default config for the Alarm Status table.\n\tdefaultConfig \u003d value[\u0027defaultStatusConfig\u0027].toDict()\n\t\n\t# Get the current column config.\n\tcolumnConfig \u003d value[\u0027columns\u0027].toDict()\n\t\n\t# See if they hold the same values.\n\tcolumnConfigIsDefault \u003d self.view.getChild(\"root\").compareDicts(columnConfig, defaultConfig[\u0027columns\u0027])\n\t\n\tif columnConfigIsDefault:\n\t\t# Column config is still default. Checking the filters.\n\t\tactiveFiltersDict \u003d value[\u0027filters\u0027][\u0027active\u0027].toDict()\n\t\tshelvedFiltersDict \u003d value[\u0027filters\u0027][\u0027shelved\u0027].toDict()\n\t\t\n\t\tfiltersConfig \u003d {\u0027active\u0027: {}, \u0027shelved\u0027: {}}\n\t\t\n\t\tfiltersConfig[\u0027active\u0027] \u003d {dictKey: dictValue for dictKey, dictValue in activeFiltersDict.iteritems() if dictKey in [\u0027text\u0027, \u0027states\u0027, \u0027priorities\u0027]}\n\t\tfiltersConfig[\u0027shelved\u0027] \u003d {dictKey: dictValue for dictKey, dictValue in shelvedFiltersDict.iteritems() if dictKey in [\u0027text\u0027]}\n\t\t\n\t\tfiltersConfigIsDefault \u003d self.view.getChild(\"root\").compareDicts(filtersConfig, defaultConfig[\u0027filters\u0027])\n\t\t\n\t\treturn False if filtersConfigIsDefault else True\n\telse:\n\t\treturn True",
