{
  "custom": {
    "alarmPriority": 0,
    "batteryCapacity": 95.6,
    "batteryCharging": "Charging",
    "batteryDischarging": "Not discharging",
    "deviceName": "UPS1A",
    "popupTitle": "Site 1 - Data Hall 1 - Section 1 - UPS 1A",
    "systemStatus": "Online"
  },
  "params": {
    "tagPath": "[DataCenterDemo]Exchange/DataCenterDemo/Site1/DataHall1/Section1/UPS/UPS1A"
  },
  "propConfig": {
    "custom.alarmPriority": {
      "binding": {
        "config": {
          "struct": {
            "tagPath": "{view.params.tagPath}",
            "watchdog": "{[default]Exchange/DataCenter/Watchdog/rate10sec}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\ttagPath \u003d value.tagPath\n\talarmMap \u003d {\n\t\t\t\"Low\": 1,\n\t\t\t\"High\": 3\n\t\t}\n\t\n\treturn max(set([alarmMap.get(str(alarm.get(\"priority\"))) for alarm in system.alarm.queryStatus(state\u003d[\"ActiveUnacked\", \"ActiveAcked\"], path\u003d[\"*%s*\" % tagPath.rsplit(\"]\",1)[1]])] + [0]))",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.batteryCapacity": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Battery/BatteryCapacityRemaining"
        },
        "transforms": [
          {
            "expression": "round({value},1)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.batteryCharging": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Battery/IsBatteryCharging"
        },
        "transforms": [
          {
            "fallback": "Unknown",
            "inputType": "scalar",
            "mappings": [
              {
                "input": false,
                "output": "Not charging"
              },
              {
                "input": true,
                "output": "Charging"
              }
            ],
            "outputType": "scalar",
            "type": "map"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.batteryDischarging": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Battery/IsBatteryDischarging"
        },
        "transforms": [
          {
            "fallback": "Unknown",
            "inputType": "scalar",
            "mappings": [
              {
                "input": false,
                "output": "Not discharging"
              },
              {
                "input": true,
                "output": "Discharging"
              }
            ],
            "outputType": "scalar",
            "type": "map"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.deviceName": {
      "binding": {
        "config": {
          "path": "view.params.tagPath"
        },
        "transforms": [
          {
            "code": "\treturn value.rsplit(\"/\",1)[1]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.popupTitle": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Info/PopupTitle"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.systemStatus": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Status/SystemStatus"
        },
        "transforms": [
          {
            "fallback": null,
            "inputType": "scalar",
            "mappings": [
              {
                "input": 1,
                "output": "Online"
              },
              {
                "input": 0,
                "output": "Offline"
              }
            ],
            "outputType": "scalar",
            "type": "map"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 153,
      "width": 187
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "AlarmIndicator"
        },
        "position": {
          "basis": "30%",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.alarmPriority} \u003e 0"
              },
              "type": "expr"
            }
          },
          "props.params.priority": {
            "binding": {
              "config": {
                "path": "view.custom.alarmPriority"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "path": "Exchange/DataCenter/Framework/Alarms/AlarmIndicator"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "DeviceName"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.deviceName"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/datacenter/singleline/equipment/common/base"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "DeviceStatus"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.systemStatus"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/datacenter/singleline/equipment/common/base"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "BatteryCharging"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.batteryCharging"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/datacenter/singleline/equipment/common/base exchange/datacenter/singleline/equipment/common/value"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "BatteryCharge"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.custom.batteryCapacity} + \" %\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/datacenter/singleline/equipment/common/base exchange/datacenter/singleline/equipment/common/value"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tviewPath \u003d \"Exchange/DataCenter/Faceplates/UpsFp\"\n\ttagPath \u003d self.view.params.tagPath\n\tpopupTitle \u003d self.view.custom.popupTitle\n\tviewParams \u003d {\"tagPath\": tagPath}\n\t\n\tpayload \u003d {\n\t\t  \u0027command\u0027 : \u0027openPopup\u0027\n\t\t, \u0027self\u0027: self\n\t\t, \u0027event\u0027: event\n\t\t, \u0027parameters\u0027: {\n\t\t\t\u0027id\u0027 : \u0027upsPopup-{tagPath}\u0027.format(tagPath \u003d tagPath)\n\t\t\t, \u0027view\u0027: viewPath\n\t\t\t, \u0027params\u0027: viewParams\n\t\t\t, \u0027title\u0027 : popupTitle\n\t\t\t, \u0027resizable\u0027 : True\n\t\t\t, \u0027modal\u0027: False\n\t\t\t, \u0027showCloseIcon\u0027: False\n\t\t}\n\t}\n\tsystem.perspective.sendMessage(\u0027pan-zoom-iframe-clicked\u0027, payload, scope \u003d \u0027session\u0027)"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "path": "view.custom.systemStatus"
          },
          "transforms": [
            {
              "code": "\tdeviceStatusClass \u003d \u0027exchange/datacenter/singleline/equipment/device/on\u0027 if value \u003d\u003d \u0027Online\u0027 else \u0027exchange/datacenter/singleline/equipment/device/off\u0027\n\t\n\treturn \u0027{deviceStatusClass} exchange/datacenter/framework/clickable\u0027.format(deviceStatusClass \u003d deviceStatusClass)",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "direction": "column",
      "justify": "space-evenly",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}