{
  "custom": {
    "aOrB": "A"
  },
  "params": {
    "selectedEquipment": {
      "tagPath": "",
      "viewPath": ""
    },
    "tagPath": "[DataCenterDemo]Exchange/DataCenterDemo/Site1/DataHall1/Section1/LVSWG/LVSWG1A"
  },
  "propConfig": {
    "custom.aOrB": {
      "binding": {
        "config": {
          "path": "view.params.tagPath"
        },
        "transforms": [
          {
            "code": "\treturn value[-1:]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.selectedEquipment": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 755,
      "width": 1199
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Diagram"
            },
            "position": {
              "basis": "712px",
              "shrink": 0
            },
            "propConfig": {
              "props.params.selectedEquipment": {
                "binding": {
                  "config": {
                    "path": "view.params.selectedEquipment"
                  },
                  "type": "property"
                }
              },
              "props.params.tagPath": {
                "binding": {
                  "config": {
                    "path": "view.params.tagPath"
                  },
                  "type": "property"
                }
              },
              "props.path": {
                "binding": {
                  "config": {
                    "expression": "\"Exchange/DataCenter/Faceplates/EmbeddedViews/Lvswg/Diagram\" + {view.custom.aOrB}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "useDefaultViewHeight": true,
              "useDefaultViewWidth": true
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "DiagramContainer"
        },
        "position": {
          "basis": "712px"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Data"
        },
        "position": {
          "basis": "400px",
          "grow": 1
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "struct": {
                  "lvswgTagPath": "{view.params.tagPath}",
                  "selectedTagPath": "{view.params.selectedEquipment.tagPath}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tselectedTagPath \u003d value.get(\u0027selectedTagPath\u0027)\n\t\n\tif selectedTagPath !\u003d None:\n\t\tif len(selectedTagPath) \u003e 0:\n\t\t\treturn selectedTagPath\n\t\telse:\n\t\t\treturn value.get(\u0027lvswgTagPath\u0027)",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.selectedEquipment.viewPath"
              },
              "transforms": [
                {
                  "code": "\tif value !\u003d None:\n\t\tif len(value) \u003e 0:\n\t\t\treturn value\n\t\telse:\n\t\t\treturn \u0027Exchange/DataCenter/Faceplates/EmbeddedViews/Lvswg/Status\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if(len({view.params.selectedEquipment.tagPath})\u003d0,\r\n\u0027exchange/datacenter/faceplates/section\u0027,\r\n\u0027\u0027)"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "params": {
            "displayTitle": true,
            "showClose": false
          },
          "style": {
            "marginLeft": "10px"
          }
        },
        "type": "ia.display.view"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "justify": "center",
      "style": {
        "row-gap": "10px"
      },
      "wrap": "wrap"
    },
    "type": "ia.container.flex"
  }
}